<Window x:Class="SqlServerLiveMover.Gui.CompareMigrationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="比較して移行" Height="820" Width="1380" MinHeight="680" MinWidth="1080"
        WindowStartupLocation="CenterOwner" Background="{StaticResource PageBrush}"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="PreviewGridCell" TargetType="DataGridCell">
            <Setter Property="Foreground" Value="#152536" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderThickness" Value="0" />
            <Style.Triggers>
                <Trigger Property="IsSelected" Value="True">
                    <Setter Property="Background" Value="#0B7285" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PreviewGridHeader" TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="#E7EEF5" />
            <Setter Property="Foreground" Value="#152536" />
            <Setter Property="FontFamily" Value="Yu Gothic UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="Height" Value="42" />
            <Setter Property="BorderBrush" Value="#C7D2DD" />
            <Setter Property="BorderThickness" Value="0,0,1,1" />
        </Style>
        <Style x:Key="PreviewGrid" TargetType="DataGrid">
            <Setter Property="AutoGenerateColumns" Value="True" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="CanUserAddRows" Value="False" />
            <Setter Property="CanUserDeleteRows" Value="False" />
            <Setter Property="GridLinesVisibility" Value="Horizontal" />
            <Setter Property="HeadersVisibility" Value="Column" />
            <Setter Property="RowHeaderWidth" Value="0" />
            <Setter Property="RowHeight" Value="42" />
            <Setter Property="BorderBrush" Value="#D5DEE7" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Background" Value="White" />
            <Setter Property="Foreground" Value="#152536" />
            <Setter Property="HorizontalGridLinesBrush" Value="#DFE6ED" />
            <Setter Property="AlternatingRowBackground" Value="#F6F9FC" />
            <Setter Property="AlternationCount" Value="2" />
            <Setter Property="FontFamily" Value="Consolas, Yu Gothic UI" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="CellStyle" Value="{StaticResource PreviewGridCell}" />
            <Setter Property="ColumnHeaderStyle" Value="{StaticResource PreviewGridHeader}" />
            <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
            <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="86" />
            <RowDefinition Height="*" />
            <RowDefinition Height="70" />
        </Grid.RowDefinitions>

        <Border Background="#102A43">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="COMPARE &amp; MOVE" Foreground="#6FE7E7" FontSize="11" FontWeight="Bold" />
                    <TextBlock Text="1テーブルを左右で確認して、必要なデータだけ移行" Foreground="White"
                               FontSize="23" FontWeight="SemiBold" Margin="0,4,0,0" />
                </StackPanel>
                <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                    <TextBlock x:Name="EndpointText" Foreground="#BEE3F8" FontSize="12"
                               TextAlignment="Right" TextTrimming="CharacterEllipsis" MaxWidth="620" />
                    <TextBlock Text="プレビューは読み取り専用・先頭1,000件" Foreground="#8FB3C9"
                               FontSize="11" TextAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="TablePanelColumn" Width="270" />
                <ColumnDefinition x:Name="TablePanelSpacerColumn" Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border x:Name="TablePanel" Background="White" CornerRadius="8" Padding="16">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,12">
                        <TextBlock Text="移行対象テーブル" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock x:Name="SelectionSummaryText" Text="1件選択してください"
                                   Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,3,0,0" />
                    </StackPanel>
                    <ListBox x:Name="TableList" Grid.Row="1" ItemsSource="{Binding Items}"
                             SelectedIndex="0" SelectionChanged="TableList_SelectionChanged"
                             BorderThickness="0" Background="Transparent" FontSize="14"
                             HorizontalContentAlignment="Stretch">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="2,6">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Source}" FontWeight="SemiBold"
                                                   FontSize="15" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding TargetDisplay}" Foreground="{StaticResource MutedBrush}"
                                                   FontSize="13" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding OperationDisplay}" Foreground="{StaticResource AccentBrush}"
                                                   FontSize="12" Margin="0,3,0,0" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Grid.Row="2" Text="テーブルは1件ずつ選択します"
                               Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="2,12,0,0" />
                </Grid>
            </Border>

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="12" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Background="White" CornerRadius="8" Padding="16,13">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Button x:Name="ToggleTablePanelButton"
                                    Style="{StaticResource SecondaryButton}"
                                    Width="42" Height="38" Padding="7"
                                    Click="ToggleTablePanel_Click" Margin="0,0,12,0"
                                    VerticalAlignment="Center" ToolTip="テーブル一覧を隠す">
                                <Grid Width="22" Height="20">
                                    <Border BorderBrush="#557184" BorderThickness="1.5" CornerRadius="2" />
                                    <Border Width="6" Margin="3" HorizontalAlignment="Left"
                                            Background="#8FCBD2" CornerRadius="1" />
                                    <Path x:Name="TablePanelToggleArrow"
                                          Data="M 17,5 L 12,10 L 17,15"
                                          Stroke="#36586A" StrokeThickness="1.8"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          RenderTransformOrigin="0.5,0.5" />
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Name="CurrentTableText" Text="テーブルを選択してください"
                                           FontSize="17" FontWeight="SemiBold" />
                                <TextBlock x:Name="SchemaSummaryText" Text="列情報を取得するとここに表示されます"
                                           Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,3,0,0" />
                                <TextBlock x:Name="RowSelectionSummaryText" Text="移行するデータを選択してください"
                                           Foreground="{StaticResource AccentBrush}" FontSize="11" FontWeight="SemiBold"
                                           Margin="0,3,0,0" />
                            </StackPanel>
                        </Grid>
                        <Button x:Name="MigrationDirectionButton" Grid.Column="1"
                                Width="56" Height="56" Padding="4"
                                Background="Transparent" BorderThickness="0" Cursor="Hand"
                                Click="MigrationDirection_Click"
                                HorizontalAlignment="Center" VerticalAlignment="Center"
                                ToolTip="移行方向: 左から右（クリックして切り替え）">
                            <Path x:Name="MigrationDirectionIcon"
                                  Data="M 0,0 L 30,18 L 0,36 Z"
                                  Fill="#A9C3CC"
                                  Stretch="Uniform" Width="30" Height="36"
                                  RenderTransformOrigin="0.5,0.5" />
                        </Button>
                        <StackPanel Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="プレビューを絞り込み" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource MutedBrush}" Margin="0,0,0,3" />
                            <StackPanel Orientation="Horizontal">
                                <TextBox x:Name="PreviewFilterTextBox" Width="210" Padding="8,5"
                                         TextChanged="PreviewFilter_TextChanged"
                                         ToolTip="左右いずれかに含まれる文字列で絞り込みます" />
                                <Button Content="解除" Style="{StaticResource SecondaryButton}"
                                        Padding="10,6" Margin="6,0,0,0"
                                        Click="ClearPreviewFilter_Click" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Background="White" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="2,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="LeftPreviewTitle" Text="移行元プレビュー" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="SourceCountText" Grid.Column="1" Text="— 件"
                                           FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" />
                            </Grid>
                            <DataGrid x:Name="SourcePreviewGrid" Grid.Row="1" Style="{StaticResource PreviewGrid}"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      AutoGeneratingColumn="PreviewGrid_AutoGeneratingColumn"
                                      SelectionChanged="PreviewGrid_SelectionChanged"
                                      ScrollViewer.ScrollChanged="PreviewGrid_ScrollChanged" />
                        </Grid>
                    </Border>
                    <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="2,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="RightPreviewTitle" Text="移行先プレビュー" FontSize="14" FontWeight="SemiBold" />
                                <TextBlock x:Name="TargetCountText" Grid.Column="1" Text="— 件"
                                           FontSize="14" FontWeight="SemiBold" Foreground="#2F6690" />
                            </Grid>
                            <DataGrid x:Name="TargetPreviewGrid" Grid.Row="1" Style="{StaticResource PreviewGrid}"
                                      SelectionMode="Extended" SelectionUnit="FullRow"
                                      AutoGeneratingColumn="PreviewGrid_AutoGeneratingColumn"
                                      SelectionChanged="PreviewGrid_SelectionChanged"
                                      ScrollViewer.ScrollChanged="PreviewGrid_ScrollChanged" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <Border Grid.Row="2" Background="White" BorderBrush="#D9E2EC" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <ProgressBar x:Name="BusyProgress" Width="100" Height="5" IsIndeterminate="True"
                                 Visibility="Collapsed" Foreground="{StaticResource AccentBrush}" />
                    <TextBlock x:Name="StatusText" Text="準備完了" Margin="10,0,0,0"
                               Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                    <CheckBox x:Name="BackupBeforeCopyCheckBox" Content="事前バックアップ"
                              VerticalAlignment="Center" Margin="0,0,14,0"
                              ToolTip="移行前に移行先テーブル全体をバックアップします" />
                    <Button x:Name="ClearRowsButton" Content="データ選択解除"
                            Style="{StaticResource SecondaryButton}" Click="ClearRows_Click" Margin="0,0,8,0" />
                    <Button x:Name="RefreshButton" Content="プレビュー更新" Style="{StaticResource SecondaryButton}"
                            Click="Refresh_Click" Margin="0,0,8,0" />
                    <Button x:Name="PreflightButton" Content="テーブルを事前検査" Style="{StaticResource SecondaryButton}"
                            Click="Preflight_Click" Margin="0,0,8,0" />
                    <Button x:Name="MoveButton" Content="選択データを左→右へ移行" Style="{StaticResource PrimaryButton}"
                            Click="Move_Click" Margin="0,0,8,0" />
                    <Button x:Name="CancelButton" Content="中止" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click" IsEnabled="False" Margin="0,0,8,0" />
                    <Button Content="閉じる" Style="{StaticResource SecondaryButton}" Click="Close_Click" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
