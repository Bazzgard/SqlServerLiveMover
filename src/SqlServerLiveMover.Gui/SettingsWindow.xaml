<Window x:Class="SqlServerLiveMover.Gui.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="接続と実行設定" Height="690" Width="720"
        MinHeight="620" MinWidth="620" WindowStartupLocation="CenterOwner"
        Background="{StaticResource PageBrush}" ShowInTaskbar="False">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="78" />
            <RowDefinition Height="*" />
            <RowDefinition Height="66" />
        </Grid.RowDefinitions>

        <Border Background="#102A43">
            <StackPanel Margin="28,0" VerticalAlignment="Center">
                <TextBlock Text="接続と実行設定" Foreground="White" FontSize="24" FontWeight="SemiBold" />
                <TextBlock Text="接続先、読み取り方式、実行単位を設定します。"
                           Foreground="#BEE3F8" FontSize="12" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <Border Grid.Row="1" Margin="22" Background="White" CornerRadius="8" Padding="24">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="移行元 接続文字列" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox Text="{Binding SourceConnectionString, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="78" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />

                    <TextBlock Text="移行先 接続文字列" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <TextBox Text="{Binding TargetConnectionString, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" Height="78" TextWrapping="Wrap"
                             VerticalScrollBarVisibility="Auto" />
                    <TextBlock Text="環境変数は ${NAME} 形式で指定できます。"
                               Foreground="{StaticResource MutedBrush}" FontSize="12" Margin="0,5,0,0" />

                    <TextBlock Text="読み取り整合性" FontWeight="SemiBold" Margin="0,18,0,6" />
                    <ComboBox SelectedValue="{Binding SourceConsistency}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="Snapshot — 無停止・一点時点" Tag="snapshot" />
                        <ComboBoxItem Content="Locked — 設定変更なし・書込待機あり" Tag="locked" />
                        <ComboBoxItem Content="Read committed — 影響最小・整合性保証なし" Tag="readCommitted" />
                    </ComboBox>

                    <Grid Margin="0,18,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="バッチ行数" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding BatchSize, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="タイムアウト（秒）" FontWeight="SemiBold" Margin="0,0,0,6" />
                            <TextBox Text="{Binding CommandTimeoutSeconds, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                    </Grid>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <Border Grid.Row="2" Background="White" BorderBrush="#D9E2EC" BorderThickness="0,1,0,0">
            <Grid Margin="22,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="設定ファイル" FontWeight="SemiBold" FontSize="11" />
                    <TextBlock x:Name="ConfigPathText" Text="未保存" MaxWidth="390"
                               TextTrimming="CharacterEllipsis" Foreground="{StaticResource MutedBrush}"
                               FontSize="11" Margin="0,2,0,0"
                               ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="キャンセル" Style="{StaticResource SecondaryButton}"
                            Click="Cancel_Click" Margin="0,0,8,0" IsCancel="True" />
                    <Button Content="読込" Style="{StaticResource SecondaryButton}"
                            Click="LoadConfig_Click" Margin="0,0,8,0" />
                    <Button Content="保存" Style="{StaticResource PrimaryButton}"
                            Click="SaveConfig_Click" IsDefault="True" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
